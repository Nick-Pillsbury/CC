# Copy these values into the existing server Compose configuration.
MASTER_API_CLIENT_MODE=http
MASTER_API_CONTROLLER_BASE_URL=http://controller-api:8002
MASTER_API_VIDEO_BASE_URL=http://host.docker.internal:8001
MASTER_API_CONTROL_LEASE_SECONDS=2.0
MASTER_API_MONITOR_INTERVAL_SECONDS=1.0
MASTER_API_HISTORY_PATH=/data/master-history.sqlite3
MASTER_API_HISTORY_LIMIT=10000
